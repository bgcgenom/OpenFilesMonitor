<Window x:Class="OpenFilesMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Files Monitor" Height="800" Width="1400"
        MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Add Server" Click="BtnAddServer_Click"/>
            <Button Content="Remove Selected Server" Click="BtnRemoveServer_Click"/>
            <Separator/>
            <Button Content="Refresh Now" Click="BtnRefresh_Click"/>
            <TextBox x:Name="TxtFilter" Width="260" Margin="8,0,0,0" />
            <Button Content="Clear Filter" Click="BtnClearFilter_Click"/>
            <Button Content="Export CSV" Click="BtnExportCsv_Click"/>
            <Separator/>
            <Button Content="Close Selected" Click="BtnCloseSel_Click"/>
            <Button Content="Close Selected (Force)" Click="BtnCloseSelForce_Click"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Auto-refresh:" Margin="0,0,6,0"/>
                    <CheckBox x:Name="ChkAuto" VerticalAlignment="Center"/>
                    <TextBlock Text="Every (sec):" Margin="12,0,6,0"/>
                    <TextBox x:Name="TxtInterval" Width="60" Text="30"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Servers" Grid.Column="0" Margin="0,0,8,0">
                <ListBox x:Name="ServersList"/>
            </GroupBox>

            <GroupBox Header="Open Files" Grid.Column="1">
                <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionMode="Extended" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="140"/>
                        <DataGridTextColumn Header="User" Binding="{Binding User}" Width="170"/>
                        <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="140"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                        <DataGridTextColumn Header="Share Path" Binding="{Binding SharePath}" Width="220"/>
                        <DataGridTextColumn Header="FileId" Binding="{Binding FileId}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>